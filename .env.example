# Copy to .env for local development (node scripts/dev.mjs reads process.env).
# On Cloudflare, set these with `npx wrangler secret put NAME` instead. Never commit real values.

# Required as soon as any real provider is configured. The phone app sends it with every request.
APP_ACCESS_CODE=

# Transcription. Leave empty on Cloudflare to use the built-in Nova-3 (AI binding).
DEEPGRAM_API_KEY=

# Coaching and roleplay (Phase 2+).
ANTHROPIC_API_KEY=

# Force the canned test provider even when keys are present: PROVIDER_MODE=mock
PROVIDER_MODE=
